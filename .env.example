# ============================================================
# Environment variables template for penetration-pipeline
# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored and MUST NOT be committed.
# ============================================================

# Target URL to scan. Override the config/default target.
# WARNING: Only scan systems you own or have explicit written permission
# to test. Unauthorized scanning is illegal under UU ITE (Indonesia).
TARGET_URL=https://www.klikindomaret.com/

# (Optional) HTTP/HTTPS proxy, e.g. for Burp/ZAP
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

# (Optional) Authorization token / API key for authenticated tests
# AUTH_TOKEN=
